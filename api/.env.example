SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
DEFAULT_HOLIDAY_REGION=CH
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_CHAT=gpt-4.1-mini
OPENAI_MODEL_VISION=gpt-4.1-mini
AGENT_MAX_FILE_BYTES=5242880
AGENT_MAX_FILES_PER_MESSAGE=4
# Server-only: canonical base64 encoding of 32 random bytes for encrypted Bring credentials.
# Generate and store in Azure secret settings; leave empty to disable credential editing.
BRING_CREDENTIALS_KEY=
# Optional, server-side secret: map household UUIDs to { "mail": "...", "password": "..." }.
# Keep actual values in Azure/GitHub secret stores, never in frontend VITE_ variables.
BRING_ACCOUNTS_JSON={}
