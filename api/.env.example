SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
DEFAULT_HOLIDAY_REGION=CH
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_CHAT=gpt-4.1-mini
OPENAI_MODEL_VISION=gpt-4.1-mini
AGENT_MAX_FILE_BYTES=5242880
AGENT_MAX_FILES_PER_MESSAGE=4
AGENT_MAX_REQUEST_BYTES=31457280
AGENT_MAX_TOTAL_FILE_BYTES=20971520
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_MAX_HISTORY_ITEMS=20
AGENT_MAX_HISTORY_ITEM_CHARS=4000
AGENT_MAX_HISTORY_CHARS=20000
AGENT_MAX_TOOL_CALLS_PER_RESPONSE=8
AGENT_MAX_TOOL_CALLS_PER_TURN=16
AGENT_MAX_TOOL_RESULT_CHARS=16000
AGENT_MAX_OUTPUT_TOKENS=1200
AGENT_MAX_EXECUTION_MS=45000
AGENT_USER_DAILY_LIMIT=40
AGENT_HOUSEHOLD_DAILY_LIMIT=100
AGENT_USER_CONCURRENCY_LIMIT=2
AGENT_HOUSEHOLD_CONCURRENCY_LIMIT=3
AGENT_RESERVATION_TIMEOUT_SECONDS=120
# Server-only: canonical base64 encoding of 32 random bytes for encrypted Bring credentials.
# Generate and store in Azure secret settings; leave empty to disable credential editing.
BRING_CREDENTIALS_KEY=
# Optional, server-side secret: map household UUIDs to { "mail": "...", "password": "..." }.
# Keep actual values in Azure/GitHub secret stores, never in frontend VITE_ variables.
BRING_ACCOUNTS_JSON={}
