generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DayConfigurationType {
  PUBLIC_HOLIDAY
  BRIDGE_DAY
  SCHOOL_HOLIDAY
  CUSTOM
}

enum DayConfigurationSource {
  AUTO
  CUSTOM
}

model Household {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  holidayRegion  String
  members        HouseholdMember[]
  contacts       Contact[]
  eventCategories EventCategory[]
  events         Event[]
  dayConfigurations DayConfiguration[]
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)
}

model HouseholdMember {
  id                String    @id @default(uuid()) @db.Uuid
  householdId       String    @db.Uuid
  firstName         String
  role              String?
  avatarColor       String
  avatarPhotoUrl    String?
  visibleInCalendar Boolean   @default(true)
  sortOrder         Int       @map("order")
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events            Event[]
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([householdId, sortOrder])
  @@index([householdId, sortOrder])
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  firstName  String
  lastName   String?
  mobilePhone String?
  email      String?
  birthDay   Int?      @db.SmallInt
  birthMonth Int?      @db.SmallInt
  birthYear  Int?      @db.SmallInt
  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events     Event[]
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  @@index([householdId, firstName, lastName])
}

model EventCategory {
  id         String    @id @default(uuid()) @db.Uuid
  householdId String   @db.Uuid
  name       String
  color      String?
  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  events     Event[]
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([householdId, name])
}

model Event {
  id                String          @id @default(uuid()) @db.Uuid
  householdId       String          @db.Uuid
  householdMemberId String          @db.Uuid
  contactId         String?         @db.Uuid
  categoryId        String          @db.Uuid
  title             String
  startAt           DateTime        @db.Timestamptz(6)
  endAt             DateTime?       @db.Timestamptz(6)
  allDay            Boolean         @default(false)
  isRecurring       Boolean         @default(false)
  rrule             String?
  notes             String?
  household         Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  householdMember   HouseholdMember @relation(fields: [householdMemberId], references: [id], onDelete: Restrict)
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  category          EventCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)

  @@index([householdId, startAt])
  @@index([householdMemberId, startAt])
  @@index([contactId])
  @@index([categoryId])
}

model DayConfiguration {
  id                        String                 @id @default(uuid()) @db.Uuid
  householdId               String                 @db.Uuid
  name                      String
  type                      DayConfigurationType
  startDate                 DateTime               @db.Date
  endDate                   DateTime?              @db.Date
  source                    DayConfigurationSource @default(CUSTOM)
  displayColor              String?
  relatedDayConfigurationId String?                @db.Uuid
  household                 Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  relatedDayConfiguration   DayConfiguration?      @relation("DayConfigurationDerivation", fields: [relatedDayConfigurationId], references: [id], onDelete: SetNull)
  derivedDayConfigurations  DayConfiguration[]     @relation("DayConfigurationDerivation")
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @updatedAt @db.Timestamptz(6)

  @@index([householdId, startDate])
  @@index([householdId, endDate])
  @@index([relatedDayConfigurationId])
}
