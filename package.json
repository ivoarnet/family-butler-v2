{
  "name": "family-butler-v2",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "api"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "npm run dev --workspace api",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace api && npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
